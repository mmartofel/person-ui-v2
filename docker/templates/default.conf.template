# The UI: static files of the Vite build, SPA fallback, and /api proxied to the API (same origin, no CORS).
# Rendered at container start by the nginx image (envsubst of ${API_UPSTREAM} and ${OIDC_ORIGIN} only, see Dockerfile).
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/css text/javascript application/javascript application/json image/svg+xml;

    include /etc/nginx/conf.d/security-headers.inc;

    # Routes of the app: index.html, revalidated on every load so a new release is picked up.
    location / {
        try_files $uri /index.html;
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Hashed build output: cached for a year; a missing file is a 404, not index.html.
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Runtime configuration written by docker/10-ui-runtime-config.envsh.
    location = /config.js {
        alias /tmp/runtime/config.js;
        default_type text/javascript;
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        # The server's security headers replace the API's, so a response never carries two policies.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    # The two public Actuator endpoints of the footer's API status (docs/API-CONTRACT.md "Status endpoints"); no
    # other /actuator path is exposed.
    location ~ ^/actuator/(health|info)$ {
        proxy_pass ${API_UPSTREAM};
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Liveness and readiness probe.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }
}
